{
  "name": "my-game-launcher",
  "version": "0.5.0",
  "description": "一个面向 Windows 的本地游戏启动器，用于统一管理、启动并统计本地游戏的游玩时长。",
  "main": "main.js",
  "author": "makise-kurisu-tina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/makise-kurisu-tina/my-game-launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "predist": "npm run icon",
    "dist": "electron-builder --win nsis --x64",
    "prepack": "npm run icon",
    "pack": "electron-builder --dir --win"
  },
  "build": {
    "appId": "com.mygamelauncher.app",
    "productName": "My Game Launcher",
    "icon": "build/icon-convert/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "My-Game-Launcher-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Game Launcher"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
